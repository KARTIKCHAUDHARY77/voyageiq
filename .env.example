# Copy to .env and fill in. .env is git-ignored; this example file is safe to commit.
FLASK_ENV=development
PORT=5000

# Required in production: random strings, 32+ characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Empty = local SQLite file. Production example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Optional. Enables the GPT-backed AI Copilot; a rule-based engine is used without it.
OPENAI_API_KEY=

# Exact browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo accounts with a published password. true for local development only.
SEED_DEMO_DATA=false
# Public self-signup. Closed by default in production.
ALLOW_REGISTRATION=false

# First-run admin for a fresh production database (used only when no admin exists).
# Remove ADMIN_PASSWORD from the environment after the first deploy.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# docker-compose only
POSTGRES_PASSWORD=
